# ============================================================
# Cyb Robotics Organization Website — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to GitHub (it should already be in .gitignore).
# ============================================================

# --- Supabase ---
# Found in Supabase Dashboard > Project Settings > API

# Safe to expose to the browser (used by client-side Supabase client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, never expose to the client.
# Bypasses Row Level Security. Used only in server actions/API routes for admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# --- Members Page (Unlisted Route) ---
# The secret slug used in the URL, e.g. /members-portal/<this-value>
# Keep this long and hard to guess. Share it only through official org channels.
MEMBERS_PAGE_SECRET_SLUG=your-long-random-unguessable-slug


# --- Site Config ---
# Base URL of the deployed site (used for metadata, sitemaps, absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
